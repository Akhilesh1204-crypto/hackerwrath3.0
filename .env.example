# ---------------------------------------------------------------------------
# SwapStay Full-Stack Environment Variables (Frontend + Backend)
# Copy to .env.local and fill in your values. Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase Public (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Admin / Service Role (SERVER ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage Buckets (Supabase Storage)
NEXT_PUBLIC_SUPABASE_PHOTO_BUCKET=property-photos
NEXT_PUBLIC_SUPABASE_VERIFICATION_BUCKET=verification

# Application & API Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api

# Credit System Configuration
CREDIT_PER_HOSTED_NIGHT=1
CREDIT_PER_BOOKED_NIGHT=1

# Demo Mode (Allows previewing app UI with mocked data without live database)
NEXT_PUBLIC_DEMO_MODE=false

# Optional Backend URL (only needed if frontend is hosted separately from backend)
# BACKEND_URL=
